mainmenu "DANT Application"

source "Kconfig.zephyr"

menu "DANT options"

choice DANT_NODE_ROLE
	prompt "DANT node role"
	default DANT_NODE_A

config DANT_NODE_A
	bool "Node A"

config DANT_NODE_B
	bool "Node B"

endchoice

config DANT_CAN_LOOPBACK
	bool "Enable CAN loopback mode for self-test"
	default n

config DANT_TX_PERIOD_MS
	int "TX period in milliseconds"
	default 1000
	range 10 60000

endmenu